# Copia este archivo a .env y completa los valores

# El modo SSL se configura en DATABASE_URL:
# PostgreSQL local usa sslmode=disable; Neon requiere sslmode=require.
# Selecciona solo una URL.
MAX_IMAGE_SIZE_MB=30
JWT_SECRET_KEY=reemplaza-por-una-clave-aleatoria-segura-de-al-menos-32-caracteres
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=automarket-api
# PostgreSQL local
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/bdconcesionario?sslmode=disable

# PostgreSQL Neon
# DATABASE_URL=postgresql+psycopg2://neondb_owner:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudinary (https://cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
